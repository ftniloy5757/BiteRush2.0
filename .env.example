# ==============================================================================
# BiteRush 2.0 Environment Configuration
# ==============================================================================

# 1. MongoDB Connection String (Required for saving users, orders & menu)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/biterush?retryWrites=true&w=majority

# 2. NextAuth Secret (Required for encrypting session login tokens)
NEXTAUTH_SECRET=biterush_super_secure_nextauth_secret_key_2026

# 3. NextAuth URL (Optional in Vercel, required for local development)
NEXTAUTH_URL=http://localhost:3000

# 4. Base URL for password reset links
BASEURL=http://localhost:3000

# 5. Live Email Delivery via Nodemailer (Optional)
# If left empty, verification OTPs and reset links are printed directly to the terminal console.
# If you want to send real emails to customer inboxes:
# EMAIL_NAME=your_email@gmail.com
# EMAIL_PASS=your_gmail_16_character_app_password
