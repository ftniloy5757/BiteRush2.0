# ==============================================================================
# BiteRush 2.0 Environment Configuration
# ==============================================================================

# MongoDB Connection String (Required)
# Replace with your MongoDB Atlas or local MongoDB connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/biterush?retryWrites=true&w=majority

# NextAuth Secret (Required)
# Generate any 32+ character random string (e.g. using openssl rand -base64 32)
NEXTAUTH_SECRET=biterush_super_secure_nextauth_secret_key_2026

# NextAuth URL (Optional in Vercel, required locally)
NEXTAUTH_URL=http://localhost:3000

# Base URL for Application Links
BASEURL=http://localhost:3000

# Nodemailer / Email OTP Configuration (Optional)
# EMAIL_NAME=your_email@gmail.com
# EMAIL_PASS=your_gmail_app_password
# GMAIL_USER=your_email@gmail.com
# GMAIL_PASSWORD=your_gmail_app_password
