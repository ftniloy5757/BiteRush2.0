# ==============================================================================
# BiteRush 2.0 Environment Configuration
# ==============================================================================

# 1. MongoDB Connection String (Required for saving users, orders & menu)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/biterush?retryWrites=true&w=majority

# 2. NextAuth Secret (Required for encrypting session login tokens)
NEXTAUTH_SECRET=biterush_super_secure_nextauth_secret_key_2026

# 3. NextAuth URL (Optional in Vercel, required for local development)
NEXTAUTH_URL=http://localhost:3000

# 4. Base URL for password reset links
BASEURL=http://localhost:3000

# 5. Live Email Delivery via Nodemailer (Optional)
# If left empty, verification OTPs and reset links are printed directly to the terminal console.
# EMAIL_NAME=your_email@gmail.com
# EMAIL_PASS=your_gmail_16_character_app_password

# ==============================================================================
# 6. Cryptography & Key Management Configuration (From-Scratch Security Layer)
# ==============================================================================
# Master HMAC Pepper Secret for Blind Indexing (email & phone lookup)
CRYPTO_PEPPER_SECRET=biterush_pepper_blind_lookup_master_secret_2026

# Active Cryptographic Key Version
CRYPTO_KEY_VERSION=1

# Optional Master RSA Keypair (Profile PII Asymmetric Encryption)
# CRYPTO_RSA_PUBLIC_KEY=10001:c7b94e...
# CRYPTO_RSA_PRIVATE_KEY=9a4f21:c7b94e...

# Optional Master ECC Keypair (Orders, Chat, Reviews Asymmetric Encryption)
# CRYPTO_ECC_PUBLIC_KEY=4a8f12...:7b3e91...
# CRYPTO_ECC_PRIVATE_KEY=3c91f0...

# Two-Factor Authentication Master Secret
CRYPTO_OTP_SECRET=biterush_totp_hmac_sha256_secret_key_2026
